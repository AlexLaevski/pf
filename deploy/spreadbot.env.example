# Copy to /etc/spreadbot.env, fill in, then lock it down:
#
#     sudo install -m 600 -o root -g root spreadbot.env /etc/spreadbot.env
#
# These are API private keys. On Lighter the SDK signer can also sign
# withdrawals and transfers, so treat them as keys to the money, not as
# read-only tokens. Use a dedicated API key for the bot, never the one you
# use by hand, so revoking it costs you nothing else.
#
# Never commit this file. Never paste these values into a chat, an issue, or
# a log. Run logs through scripts/redact.py before sharing them.

LIGHTER_RH_PRIVATE_KEY=
LIGHTER_CORE_PRIVATE_KEY=

# Optional: anything else the config references with ${VAR}.
# LIGHTER_RH_HOST=
